# Copia este archivo como .env.local (ignorado por git). Nunca subas claves reales.

# disabled | mock | gemini   (por defecto: disabled -> solo inventario manual)
VISION_PROVIDER=disabled

# Modelo verificado como elegible en el nivel gratuito el 2026-11-10 (ver docs/costs.md)
VISION_MODEL=gemini-3.5-flash-lite

# Clave de Google AI Studio de un proyecto SIN facturación vinculada. Solo servidor/CLI.
GEMINI_API_KEY=

# Límites conservadores del servidor
VISION_TIMEOUT_MS=45000
VISION_MAX_CONCURRENCY=1
VISION_MAX_REQUESTS_PER_MINUTE=5
VISION_MAX_UPLOAD_BYTES=3500000

# Autenticación del propietario (Fase 2). Mientras falten, Gemini NO se expone por HTTP.
APP_PASSWORD_HASH=
SESSION_SECRET=
